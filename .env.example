# ==============================================================================
# BIẾN MÔI TRƯỜNG CHO ỨNG DỤNG PREMIX DE HEUS (LOCAL & VERCEL DEPLOYMENT)
# ==============================================================================

# 1. Google Gemini API Key (Bắt buộc cho tính năng quét ảnh cân AI)
# Lấy miễn phí từ Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Google Sheet Webhook URL (Tùy chọn - Tự động đồng bộ báo cáo ca lên Google Sheet)
# Lấy từ Google Apps Script Web App Deployment URL (dạng https://script.google.com/macros/s/.../exec)
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your_script_id/exec

